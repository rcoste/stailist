# NEXT_PUBLIC_SUPABASE_URL — Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY — Supabase Dashboard → Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# DATABASE_URL — Supabase Dashboard → Connect → Connection string (pooler). Solo para migrations.
DATABASE_URL=
# ANTHROPIC_API_KEY — console.anthropic.com → API Keys (se agrega en el paso de integración de IA)
ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY — aistudio.google.com → Get API key (imágenes one-off: swipes + arquetipos)
GOOGLE_GENERATIVE_AI_API_KEY=
# DEV_LOGIN_PASSWORD — contraseña de usuarios de prueba LOCAL (la genera scripts/dev-users.mjs; nunca en producción)
DEV_LOGIN_PASSWORD=
# POSTMARK_SERVER_TOKEN — Postmark → tu Server → API Tokens (correos transaccionales de la app)
POSTMARK_SERVER_TOKEN=
# NEXT_PUBLIC_SITE_URL — dominio base para los links de los correos (ej. https://stailist.co)
NEXT_PUBLIC_SITE_URL=
# SUPABASE_SERVICE_ROLE_KEY — Supabase Dashboard → Settings → API → service_role. Se salta TODA la RLS.
# En la app la usa SOLO la limpieza diaria (app/api/cron/limpieza) para borrar las fotos de cuentas cuyo
# borrado programado venció — ahí la dueña ya no tiene sesión. Va en Vercel como --sensitive. Un test
# (lib/contrato-llave-servicio.test.ts) impide leerla fuera de lib/supabase/servicio.ts. También la usan
# scripts locales (backfill --vision descarga del bucket privado).
SUPABASE_SERVICE_ROLE_KEY=

# CRON_SECRET — secreto que protege /api/cron/* (Vercel lo manda como Bearer). Genera uno con: openssl rand -hex 24
CRON_SECRET=

# OPENROUTER_API_KEY — openrouter.ai → Keys → Create Key. UNA sola llave da acceso a
# decenas de modelos que no son de Anthropic ni de Google (Kimi K2, DeepSeek, Qwen,
# Llama). La usa SOLO el comparador de /admin: sin ella esos modelos salen apagados
# en la pantalla, y nada más del producto se entera.
OPENROUTER_API_KEY=

# ADMIN_EMAIL — a dónde llegan las alarmas de la vigilancia de IA (fallos en
# racha, gasto cerca del tope). Es el correo de Roberto; sin él las alarmas
# sólo quedan en los logs de Vercel.
ADMIN_EMAIL=
# TOPE_USD_DIA — freno por persona y día, en dólares. Default 5 (ver lib/cuotas.ts:
# va POR ENCIMA de agotar las cuatro cuotas, ~$3.80, para que salte el mensaje
# útil y no el genérico). Sólo se pone aquí para poder bajarlo sin tocar código.
TOPE_USD_DIA=
# TOPE_USD_DIA_GLOBAL — el gasto de TODA la app en 24h a partir del cual la
# vigilancia avisa (al 80%). Default 25; lo normal ronda $1-2 al día.
TOPE_USD_DIA_GLOBAL=
# ─── Publicidad (lib/publicidad.ts) ─────────────────────────────────────────
# ANTES DE PONER CUALQUIER ID (el aviso de privacidad promete que no ven tu correo
# ni la app por dentro, y eso depende de ajustes de cada plataforma):
#   - Google Ads: conversiones mejoradas y "datos proporcionados por el usuario" APAGADOS.
#   - GA4 → Medición mejorada: "cambios de página según el historial" e
#     "interacciones con formularios" APAGADOS.
#   - TikTok Events Manager: "coincidencia avanzada automática" APAGADA.
#
# EL SWITCH: sin estas variables no se carga NINGUNA etiqueta. Son NEXT_PUBLIC
# (van al navegador, no son secretos): NO marcarlas --sensitive en Vercel. Next
# las hornea al construir, así que después de ponerlas hay que redeployar.
# Un ID con formato inválido se ignora en silencio (ver limpiarIds).
#
# NEXT_PUBLIC_GOOGLE_ADS_ID — Google Ads → Objetivos → Conversiones → una acción → "Configurar etiqueta" → el "ID de conversión" con forma AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_REGISTRO — misma pantalla, acción "Registro": la "Etiqueta de conversión" (lo que va después de AW-…/)
NEXT_PUBLIC_GOOGLE_ADS_LABEL_REGISTRO=
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_PRIMER_LOOK — acción "Primer look": su etiqueta de conversión
NEXT_PUBLIC_GOOGLE_ADS_LABEL_PRIMER_LOOK=
# NEXT_PUBLIC_GA4_ID — Google Analytics → Administrar → Flujos de datos → Web → "ID de medición" con forma G-XXXXXXX
NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID — TikTok Ads Manager → Herramientas → Eventos → Web → el ID del píxel (letras mayúsculas y números)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# GOOGLE_SITE_VERIFICATION — Search Console → Agregar propiedad (prefijo de URL https://stailist.co) → Etiqueta HTML → sólo el valor de content="…"
GOOGLE_SITE_VERIFICATION=

# MOTOR_PAUSADO — ponle 1 para que TODA la IA responda "el stylist está de
# descanso" sin llamar a nadie. Es el freno de mano: no hace falta desplegar
# para pararlo, basta cambiar la variable en Vercel y redeployar.
MOTOR_PAUSADO=
