# NEXT_PUBLIC_SUPABASE_URL — Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY — Supabase Dashboard → Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# DATABASE_URL — Supabase Dashboard → Connect → Connection string (pooler). Solo para migrations.
DATABASE_URL=
# ANTHROPIC_API_KEY — console.anthropic.com → API Keys (se agrega en el paso de integración de IA)
ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY — aistudio.google.com → Get API key (imágenes one-off: swipes + arquetipos)
GOOGLE_GENERATIVE_AI_API_KEY=
# DEV_LOGIN_PASSWORD — contraseña de usuarios de prueba LOCAL (la genera scripts/dev-users.mjs; nunca en producción)
DEV_LOGIN_PASSWORD=
# POSTMARK_SERVER_TOKEN — Postmark → tu Server → API Tokens (correos transaccionales de la app)
POSTMARK_SERVER_TOKEN=
# NEXT_PUBLIC_SITE_URL — dominio base para los links de los correos (ej. https://stailist.co)
NEXT_PUBLIC_SITE_URL=
# SUPABASE_SERVICE_ROLE_KEY — Supabase Dashboard → Settings → API → service_role. SOLO para
# scripts locales (backfill --vision descarga del bucket privado); la app NO la usa y no va en Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# CRON_SECRET — secreto que protege /api/cron/* (Vercel lo manda como Bearer). Genera uno con: openssl rand -hex 24
CRON_SECRET=

# OPENROUTER_API_KEY — openrouter.ai → Keys → Create Key. UNA sola llave da acceso a
# decenas de modelos que no son de Anthropic ni de Google (Kimi K2, DeepSeek, Qwen,
# Llama). La usa SOLO el comparador de /admin: sin ella esos modelos salen apagados
# en la pantalla, y nada más del producto se entera.
OPENROUTER_API_KEY=
